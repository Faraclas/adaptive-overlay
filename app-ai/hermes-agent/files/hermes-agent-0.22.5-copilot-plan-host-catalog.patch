+# Hosts a provider profile claims: the host itself and its subdomains. Upstream (#142481) reads
+# them from the profile's "hostnames" through providers.profile_for_host; 0.22.5 has neither, so
+# this Gentoo backport lists the one claim it needs (the Copilot plugin's, upstream).
+_CLAIMED_HOSTS: dict[str, tuple[str, ...]] = {"copilot": ("githubcopilot.com",)}
+
+
+def is_claimed_root_route(profile: Any, base_url: Any) -> bool:
+    """Whether *base_url* is the bare HTTPS root of a host that *profile* claims.
+
+    An account can carry such a host in model.base_url (a Copilot plan host such as
+    api.business.githubcopilot.com, which the token exchange reports as endpoints.api), and that
+    host is the provider's own endpoint, not a relay. A path, query, user info, non-default port
+    or plain HTTP keeps relay handling, so a relay mounted under a claimed host is still a relay.
+    A host the profile does not claim is no match. A URL that does not parse is no match either,
+    so it keeps relay handling.
+    """
+    from utils import base_url_hostname
+
+    if profile is None:
+        return False
+    claims = _CLAIMED_HOSTS.get(str(getattr(profile, "name", "") or ""), ())
+    normalized = normalize_route_base_url(str(base_url or "").strip())
+    try:
+        host = base_url_hostname(normalized)
+    except ValueError:  # urllib rejects the host (https://[broken, a full-width colon)
+        return False
+    return (
+        bool(host)
+        and any(host == claim or host.endswith("." + claim) for claim in claims)
+        and normalized == f"https://{host}"
+    )
+
