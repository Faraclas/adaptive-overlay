@@ -0,0 +1,93 @@
+"""A model.base_url that is the bare HTTPS root of a host the configured provider claims is that
+provider's own endpoint, not a relay, so live model discovery runs for it.
+
+Gentoo backport of NousResearch/hermes-agent#142481 to 0.22.5. The cases follow the PR's tests,
+run against the real Copilot profile, whose claim on githubcopilot.com 0.22.5 cannot declare
+on the profile itself (see route_identity._CLAIMED_HOSTS)."""
+
+import pytest
+
+from hermes_cli import models
+from hermes_cli.config import atomic_config_write
+from hermes_cli.route_identity import is_claimed_root_route
+from hermes_constants import get_hermes_home
+
+
+@pytest.fixture
+def catalog_calls(monkeypatch):
+    calls = []
+
+    def native_catalog(slug, force_refresh):
+        calls.append(("native", None))
+        return ["native-model"]
+
+    def relay_catalog(normalized, relay):
+        calls.append(("relay", relay))
+        return ["relay-model"]
+
+    monkeypatch.setitem(models._PROVIDER_CATALOG_FETCHERS, "copilot", native_catalog)
+    monkeypatch.setattr(models, "_relay_model_catalog", relay_catalog)
+    return calls
+
+
+def _discover(base_url):
+    atomic_config_write(get_hermes_home() / "config.yaml", {
+        "model": {"provider": "copilot", "base_url": base_url},
+    })
+    return models.provider_model_ids("copilot", force_refresh=True)
+
+
+@pytest.mark.parametrize("base_url", [
+    "https://api.business.githubcopilot.com",
+    "https://api.business.githubcopilot.com/",
+    "https://api.individual.githubcopilot.com",
+    "https://api.enterprise.githubcopilot.com/",
+    "HTTPS://API.BUSINESS.GITHUBCOPILOT.COM:443/",
+    "https://githubcopilot.com",
+])
+def test_bare_https_root_of_a_claimed_host_is_the_providers_own_endpoint(base_url, catalog_calls):
+    assert "native-model" in _discover(base_url)
+    assert catalog_calls == [("native", None)]
+
+
+@pytest.mark.parametrize("base_url", [
+    "https://api.business.githubcopilot.com/relay",
+    "https://api.business.githubcopilot.com/v1",
+    "https://api.business.githubcopilot.com//",
+    "https://api.business.githubcopilot.com:8443",
+    "http://api.business.githubcopilot.com",
+    "https://user@api.business.githubcopilot.com",
+    "https://api.business.githubcopilot.com?relay=1",
+    "https://api.business.githubcopilot.com?",
+    "https://[broken",
+    "https://api.business.githubcopilot.com\uff1a443",
+])
+def test_a_claimed_host_with_more_than_a_bare_https_root_stays_a_relay(base_url, catalog_calls):
+    assert "relay-model" in _discover(base_url)
+    assert catalog_calls == [("relay", base_url.rstrip("/"))]  # discovery probes the URL minus trailing slashes
+
+
+@pytest.mark.parametrize("base_url", [
+    "https://api.business.githubcopilot.com.example.com",
+    "https://notgithubcopilot.com",
+    "https://unclaimed.test",
+    "https://models.github.ai",  # upstream's plugin claims it; this backport deliberately does not
+])
+def test_a_host_the_provider_does_not_claim_stays_a_relay(base_url, catalog_calls):
+    assert "relay-model" in _discover(base_url)
+    assert catalog_calls == [("relay", base_url.rstrip("/"))]
+
+
+def test_the_profiles_own_endpoint_is_still_not_a_relay(catalog_calls):
+    assert "native-model" in _discover("https://api.githubcopilot.com")
+    assert catalog_calls == [("native", None)]
+
+
+def test_a_claim_belongs_to_its_provider_only(monkeypatch):
+    monkeypatch.setattr(models, "_get_model_config_dict",
+                        lambda: {"provider": "deepseek", "base_url": "https://api.business.githubcopilot.com"})
+    assert models._configured_relay_base_url("deepseek") == "https://api.business.githubcopilot.com"
+
+
+def test_no_profile_is_no_claim():
+    assert is_claimed_root_route(None, "https://api.business.githubcopilot.com") is False
