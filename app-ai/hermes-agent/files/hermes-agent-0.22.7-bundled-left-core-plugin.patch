 def plugin_present(plugin: str, home: Path) -> bool:
-    """Installed in *home* (enabled or not: a user who disabled it chose to). Read-only."""
-    return (home / "plugins" / plugin).is_dir()
+    """Installed in *home* (enabled or not: a user who disabled it chose to), or shipped with this
+    core as a bundled model-provider plugin (a distribution package that installs it next to core's
+    own providers, which discovery loads for every home). Read-only."""
+    if (home / "plugins" / plugin).is_dir():
+        return True
+    from providers import _BUNDLED_PLUGINS_DIR
+    return (_BUNDLED_PLUGINS_DIR / plugin / "__init__.py").is_file()
 
 
 def _core_carried(feature: LeftCoreFeature, selection: list) -> bool:
