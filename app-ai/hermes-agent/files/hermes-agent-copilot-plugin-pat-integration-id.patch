@@ -0,0 +1,57 @@
+"""A fine-grained PAT (``github_pat_*``) needs the Copilot CLI's integration id.
+
+GitHub answers a PAT sent with ``Copilot-Integration-Id: vscode-chat`` with HTTP 400 ("Personal
+Access Tokens are not supported for this endpoint") on the catalog and the chat endpoints; the
+same request with ``copilot-developer-cli`` succeeds. OAuth and exchanged tokens keep
+``vscode-chat``. Gentoo adaptive-overlay patch (issues/hermes-agent-copilot-pat-catalog.md).
+"""
+
+from __future__ import annotations
+
+from unittest.mock import patch
+
+import pytest
+
+import providers as _providers
+
+_providers.get_provider_profile("copilot")  # imports the plugin package
+from github_copilot_plugin.copilot import catalog as copilot_catalog
+
+PAT = "github_pat_fixture"
+CLI_ID = "copilot-developer-cli"
+
+
+@pytest.mark.parametrize("api_key, integration", [
+    (PAT, CLI_ID), ("tid=exchanged", "vscode-chat"), ("gho_oauth", "vscode-chat"), ("", "vscode-chat"),
+])
+@pytest.mark.parametrize("has_images", [False, True])
+def test_client_headers_pick_the_integration_id_for_the_token(api_key, integration, has_images):
+    from agent.provider_route_hooks import route_answer
+
+    headers = route_answer("client_headers", provider="copilot", base_url="https://api.business.githubcopilot.com",
+                           api_key=api_key, has_images=has_images)
+    assert headers["Copilot-Integration-Id"] == integration
+    assert ("Copilot-Vision-Request" in headers) is has_images
+
+
+@pytest.mark.parametrize("api_key, integration", [(PAT, CLI_ID), ("tid=exchanged", "vscode-chat")])
+def test_catalog_request_sends_the_integration_id_for_the_token(api_key, integration):
+    sent = []
+
+    def endpoint(url, *, timeout, headers):
+        sent.append(dict(headers))
+        return {"data": [{"id": "fixture-model", "capabilities": {"type": "chat"}}]}
+
+    with patch.object(copilot_catalog, "_github_model_catalog_cache", None), \
+            patch.object(copilot_catalog, "get_json", endpoint):
+        assert copilot_catalog.fetch_github_model_catalog(api_key=api_key)
+    assert sent[0]["Authorization"] == f"Bearer {api_key}"
+    assert sent[0]["Copilot-Integration-Id"] == integration
+
+
+def test_chat_turn_with_a_pat_sends_the_cli_integration_id():
+    from conftest import offline_chat_turn
+
+    requests = offline_chat_turn("https://api.business.githubcopilot.com", model="gpt-4.1", api_key=PAT)
+    assert requests, "the turn sent no chat request"
+    assert requests[0].headers.get("copilot-integration-id") == CLI_ID
