#!/bin/sh
# Resolve the Chromium-family executable for Hermes browser tools.
# Preference: Chrome beta, Chrome stable, Chrome, Chromium.
for browser in \
	/usr/bin/google-chrome-beta \
	/usr/bin/google-chrome-stable \
	/usr/bin/google-chrome \
	/usr/bin/chromium \
	/usr/bin/chromium-browser
do
	if [ -x "${browser}" ]; then
		exec "${browser}" "$@"
	fi
done
printf '%s\n' 'Hermes browser support is enabled but no supported Chromium binary was found.' >&2
exit 127
