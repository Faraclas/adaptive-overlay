@@ -22,8 +22,9 @@
 
 use std::process::{Command, ExitStatus};
 
+// Gentoo: the system package manager owns /usr/bin/cua-driver.
 pub(crate) const PACMAN_UPDATE_GUIDANCE: &str =
-    "This executable is managed by pacman. Update with `sudo pacman -Syu`; \
+    "This executable is managed by Portage. Update with `emerge -u x11-misc/cua-driver`; \
