@@ -32,6 +33,15 @@
 pub(crate) fn is_pacman_managed() -> bool {
     #[cfg(target_os = "linux")]
     {
+        // Gentoo: treat the system-installed binary as package-managed so the
+        // upstream self-updater never replaces files Portage owns.
+        if std::env::current_exe()
+            .ok()
+            .and_then(|path| path.canonicalize().ok())
+            .is_some_and(|path| path.starts_with("/usr/bin"))
+        {
+            return true;
+        }
         std::env::current_exe()
             .map(|path| pacman_owns_executable(&path, std::path::Path::new("/usr/bin/pacman")))
             .unwrap_or(false)
