#!/bin/bash
# lab-check-system: show that experiments in the lab changed nothing
# outside /home.
#
#   lab-check-system --record   save the baseline (done at image build)
#   lab-check-system            compare against it; exit 1 on any change
#
# Checks the md5sum of every file in the system Python's site-packages and
# every Portage-owned file of app-ai/hermes-agent, and lists files outside
# /home, /tmp, /var/tmp, /proc, /sys, /dev and /run modified since the
# baseline. Also reports the size of any Hermes pm toolchain store
# (/home/*/.hermes/tools), which the lab tests showed `hermes plugins install`
# creates on a Portage install.
set -euo pipefail

STATE=/var/lib/hermes-lab
SITE=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')

if [ "$(id -u)" -ne 0 ]; then
	echo "error: run as root (scripts/hermes-lab.sh check does this)" >&2
	exit 2
fi

site_sums() {
	find "${SITE}" -type f -print0 | sort -z | xargs -0 md5sum
}

if [ "${1:-}" = "--record" ]; then
	mkdir -p "${STATE}"
	site_sums > "${STATE}/site-packages.md5"
	touch "${STATE}/stamp"
	echo "baseline recorded: $(wc -l < "${STATE}/site-packages.md5") files in ${SITE}"
	exit 0
fi

[ -f "${STATE}/stamp" ] || { echo "error: no baseline; run with --record" >&2; exit 2; }

status=0

echo "==> ${SITE}"
sums=$(site_sums)
if [ "${sums}" = "$(cat "${STATE}/site-packages.md5")" ]; then
	echo "    unchanged ($(wc -l < "${STATE}/site-packages.md5") files)"
else
	echo "    CHANGED:"
	{ diff "${STATE}/site-packages.md5" - <<< "${sums}" | grep '^[<>]' || true; } \
		| head -40 | sed 's/^/    /'
	status=1
fi

echo "==> qcheck app-ai/hermes-agent"
if [ -z "$(qcheck -B app-ai/hermes-agent 2>&1)" ]; then
	echo "    all Portage-owned files intact"
else
	{ qcheck app-ai/hermes-agent 2>&1 | grep -v '^ \* Checking' || true; } \
		| head -20 | sed 's/^/    /'
	status=1
fi

echo "==> files modified outside /home since the baseline"
# `|| true`: head closes the pipe early on long lists (SIGPIPE + pipefail).
# /etc/hosts, hostname and resolv.conf are written by podman at start.
changed=$(find / -xdev \
	\( -path /home -o -path /tmp -o -path /var/tmp -o -path /proc -o -path /sys \
	   -o -path /dev -o -path /run -o -path /root -o -path "${STATE}" \
	   -o -path /etc/hosts -o -path /etc/hostname -o -path /etc/resolv.conf \) -prune \
	-o -type f -newer "${STATE}/stamp" -print 2>/dev/null | head -40 || true)
if [ -z "${changed}" ]; then
	echo "    none"
else
	echo "${changed}" | sed 's/^/    /'
	status=1
fi

echo "==> Hermes pm stores (expected absent unless a test created them)"
for home in /home/*; do
	[ -d "${home}/.hermes/tools" ] || continue
	echo "    ${home}/.hermes/tools: $(du -sh "${home}/.hermes/tools" | cut -f1)" \
		"($(ls "${home}/.hermes/tools" | grep -v facts.json | tr '\n' ' '))"
done

if [ "${status}" -eq 0 ]; then
	echo "PASS: system unchanged"
else
	echo "FAIL: system files changed (see above)"
fi
exit "${status}"
